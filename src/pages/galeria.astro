---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import fs from "node:fs";

const photographerName = "Grzegorz Gołębiowski";

// katalog z artystycznymi zdjęciami
const dirUrl = new URL("../../public/images/galeria/", import.meta.url);

let images: string[] = [];
try {
  const files = fs.readdirSync(dirUrl);

  images = files
    .filter((file) => /\.(jpe?g|png|webp|avif)$/i.test(file))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
    .map((file) => `/images/galeria/${file}`);
} catch (err) {
  console.error("Nie udało się odczytać katalogu Galeria:", err);
  images = [];
}
---

<BaseLayout title="Galeria – NIKIEL">
  <div class="full-bg">
    <Navbar />
    <div class="nav-spacer" aria-hidden="true"></div>

    <main class="gallery-page">
      <header class="gallery-header">
        <h1>Galeria</h1>
        <p>
          Wybrane ujęcia z realizacji projektów NIKIEL. Artystyczny zapis formy,
          światła i sylwetki.
        </p>
      </header>

      <section class="gallery-grid">
        {images.map((src, index) => (
          <figure class="gallery-item">
            <img src={src} alt={`Fotografia NIKIEL ${index + 1}`} loading="lazy" />
            <figcaption>fot. {photographerName}</figcaption>
          </figure>
        ))}
      </section>
    </main>
  </div>

  {/* Lightbox – powiększanie zdjęcia po kliknięciu */}
  <div id="lightbox" class="lightbox" aria-hidden="true">
    <button class="lightbox-close" aria-label="Zamknij podgląd">&times;</button>
    <img id="lightbox-img" src="" alt="Podgląd fotografii NIKIEL" />
  </div>

  <style>
    .full-bg {
      min-height: 100vh;
      background: linear-gradient(to bottom, #2a2a2a, #d0d0d0);
    }

    :global(body) {
      background: transparent !important;
    }

    .nav-spacer {
      height: 64px;
    }

    .gallery-page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 3.5rem;
      color: #f5f5f5;
    }

    .gallery-header h1 {
      font-size: 2.2rem;
      margin-bottom: 0.75rem;
    }

    .gallery-header p {
      max-width: 640px;
      line-height: 1.7;
      font-size: 1.05rem;
      opacity: 0.9;
    }

    .gallery-grid {
      margin-top: 2.5rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.4rem;
    }

    .gallery-item {
      position: relative;
      overflow: hidden;
      border-radius: 16px;
      border: 1px solid #2a2a2a;
      background: #111111;
      margin: 0;
      cursor: zoom-in;
    }

    .gallery-item img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      transition: transform 0.4s ease, filter 0.4s ease;
    }

    .gallery-item:hover img {
      transform: scale(1.05);
      filter: brightness(1.02);
    }

    .gallery-item figcaption {
      position: absolute;
      right: 10px;
      bottom: 10px;
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.6);
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.9;
    }

    /* Lightbox – pełnoekranowy podgląd */
    .lightbox {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.9);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
      z-index: 999;
    }

    .lightbox.open {
      opacity: 1;
      pointer-events: auto;
    }

    .lightbox img {
      max-width: 90vw;
      max-height: 90vh;
      object-fit: contain;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7);
      border-radius: 10px;
    }

    .lightbox-close {
      position: absolute;
      top: 18px;
      right: 22px;
      font-size: 2rem;
      background: transparent;
      border: none;
      color: #f5f5f5;
      cursor: pointer;
      padding: 0;
      line-height: 1;
    }

    @media (max-width: 600px) {
      .gallery-page {
        padding: 2.2rem 1.1rem 3rem;
      }
    }
  </style>

  <script>
    const overlay = document.getElementById("lightbox");
    const overlayImg = document.getElementById("lightbox-img");
    const closeBtn = document.querySelector(".lightbox-close");
    const thumbs = document.querySelectorAll(".gallery-item img");

    function openLightbox(src) {
      if (!overlay || !overlayImg) return;
      overlayImg.src = src;
      overlay.classList.add("open");
      overlay.setAttribute("aria-hidden", "false");
    }

    function closeLightbox() {
      if (!overlay || !overlayImg) return;
      overlay.classList.remove("open");
      overlay.setAttribute("aria-hidden", "true");
      overlayImg.src = "";
    }

    thumbs.forEach((img) => {
      img.addEventListener("click", () => {
        openLightbox(img.src);
      });
    });

    if (closeBtn) {
      closeBtn.addEventListener("click", (event) => {
        event.stopPropagation();
        closeLightbox();
      });
    }

    if (overlay) {
      overlay.addEventListener("click", (event) => {
        // kliknięcie w tło zamyka
        if (event.target === overlay) {
          closeLightbox();
        }
      });
    }

    // 🔹 Kliknięcie w powiększone zdjęcie też zamyka
    if (overlayImg) {
      overlayImg.addEventListener("click", () => {
        closeLightbox();
      });
    }

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeLightbox();
      }
    });
  </script>
</BaseLayout>
