---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import fs from "node:fs";

// 🔧 Dane kolekcji Cube
const collectionName = "Cube";
const description = `Czarna bluza z kapturem uszyta w formie płaszcza.
Pikowany kaptur nadaje geometryczną formę, a surowe wykończenie szwów – swobodny charakter.
Dodatkowym atutem są kieszenie ukryte w szwach.
Wysokogatunkowa bawełna zapewnia trwałość produktu.
Fason – unisex.`;
const folderName = "cube"; // folder w public/images/

const dirUrl = new URL(`../../../public/images/${folderName}/`, import.meta.url);

let images: string[] = [];
try {
  const files = fs.readdirSync(dirUrl);

  images = files
    .filter((file) => /\.(jpe?g|png|webp|avif)$/i.test(file))
    .filter((file) => !file.toLowerCase().includes("cover"))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
    .map((file) => `/images/${folderName}/${file}`);
} catch (err) {
  console.error(`Nie udało się odczytać katalogu: ${folderName}`, err);
  images = [];
}
---

<BaseLayout title={`${collectionName} – kolekcja NIKIEL`}>
  <div class="full-bg">
    <Navbar />
    <div class="nav-spacer" aria-hidden="true"></div>

    <main class="collection-page">
      <header>
        <h1>{collectionName}</h1>
        <p>{description}</p>
      </header>

      <section class="gallery">
        {images.map((src, index) => (
          <img src={src} alt={`${collectionName} — look ${index + 1}`} loading="lazy" />
        ))}
      </section>
    </main>
  </div>

  {/* LIGHTBOX — powiększanie zdjęcia */}
  <div id="lightbox" class="lightbox" aria-hidden="true">
    <button class="lightbox-close" aria-label="Zamknij podgląd">&times;</button>
    <img id="lightbox-img" src="" alt="Podgląd zdjęcia" />
  </div>

  <style>
    .full-bg {
      min-height: 100vh;
      background: linear-gradient(to bottom, #2a2a2a, #d0d0d0);
    }

    :global(body) {
      background: transparent !important;
    }

    .nav-spacer {
      height: 64px;
    }

    .collection-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 3.5rem;
      color: #f5f5f5;
    }

    header h1 {
      font-size: 2rem;
      margin-bottom: 0.6rem;
    }

    header p {
      max-width: 680px;
      line-height: 1.7;
      font-size: 1.05rem;
      opacity: 0.92;
      white-space: pre-line;
    }

    .gallery {
      margin-top: 2rem;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .gallery img {
      width: 100%;
      display: block;
      object-fit: cover;
      border-radius: 12px;
      border: 1px solid #2b2b2b;
      background: #151515;
      cursor: zoom-in;
      transition: transform 0.3s ease;
    }

    .gallery img:hover {
      transform: scale(1.04);
    }

    @media (max-width: 900px) {
      .gallery {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 600px) {
      .gallery {
        grid-template-columns: 1fr;
      }
    }

    /* LIGHTBOX  */
    .lightbox {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.9);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
      z-index: 999;
    }

    .lightbox.open {
      opacity: 1;
      pointer-events: auto;
    }

    .lightbox img {
      max-width: 90vw;
      max-height: 90vh;
      border-radius: 8px;
      object-fit: contain;
    }

    .lightbox-close {
      position: absolute;
      top: 20px;
      right: 28px;
      font-size: 2rem;
      background: transparent;
      border: none;
      color: #fff;
      cursor: pointer;
    }
  </style>

  <script>
    const overlay = document.getElementById("lightbox");
    const overlayImg = document.getElementById("lightbox-img");
    const closeBtn = document.querySelector(".lightbox-close");
    const thumbs = document.querySelectorAll(".gallery img");

    function openLightbox(src) {
      if (!overlay || !overlayImg) return;
      overlayImg.src = src;
      overlay.classList.add("open");
      overlay.setAttribute("aria-hidden", "false");
    }

    function closeLightbox() {
      if (!overlay || !overlayImg) return;
      overlayImg.src = "";
      overlay.classList.remove("open");
      overlay.setAttribute("aria-hidden", "true");
    }

    thumbs.forEach((img) => {
      img.addEventListener("click", () => openLightbox(img.src));
    });

    if (closeBtn) {
      closeBtn.addEventListener("click", closeLightbox);
    }

    if (overlay) {
      overlay.addEventListener("click", (event) => {
        if (event.target === overlay) {
          closeLightbox();
        }
      });
    }

    if (overlayImg) {
      overlayImg.addEventListener("click", closeLightbox);
    }

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeLightbox();
    });
  </script>
</BaseLayout>
